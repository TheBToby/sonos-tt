[Unit]
Description=Sonos TT Flutter Kiosk (flutter-pi)
After=network-online.target soco-cli.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/flutter-pi --release /opt/sonos-tt
Restart=on-failure
RestartSec=3

# Security / resource limits
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sonos-tt /run/user/1000
PrivateTmp=true
# flutter-pi opens DRM/GPU/input devices directly. These are group-owned by
# video (/dev/dri/card*), render (/dev/dri/renderD*), and input
# (/dev/input/event*) on Raspberry Pi OS. SupplementaryGroups guarantees
# access even if the User hasn't been manually added to all groups.
SupplementaryGroups=video render input

[Install]
WantedBy=multi-user.target