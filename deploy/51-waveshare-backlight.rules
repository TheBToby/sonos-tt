# Grant read/write access to ALL hidraw devices for the input group.
#
# The Waveshare display's USB controller uses varying VID/PID combinations
# across models and revisions. Rather than enumerating every possible ID,
# we grant the input group (which includes the Flutter kiosk user) access
# to all hidraw devices. This is standard practice for embedded kiosks.
#
# This rule also covers the USB subsystem for completeness.
#
# Installation:
#   sudo cp 51-waveshare-backlight.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --action=add --subsystem-match=hidraw
#
# Then replug the USB cable (or reboot) for the rule to take effect.

# Grant input group access to ALL hidraw devices
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", MODE="0666", GROUP="input"