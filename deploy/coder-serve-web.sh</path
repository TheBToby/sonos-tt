#!/usr/bin/env bash
# =============================================================================
# coder-serve-web.sh — Publish & serve the app + real SoCo-CLI API (proxied).
#
#   bash deploy/coder-serve-web.sh            # foreground
#   bash deploy/coder-serve-web.sh --daemon   # background (nohup + pidfiles)
#
# Starts:
#   1. soco-http-api-server (REAL SoCo-CLI, from the persistent venv) on :5001
#      — discovers/talks to real Sonos speakers in SOCO_SUBNETS (192.168.0.0/24).
#      Speaker cache lives in /opt/coder/sonos-tt/soco-home (persistent).
#   2. coder-web-server.py on :8099 — static Flutter app + same-origin
#      /soco proxy → :5001. Dual-stack (IPv4+IPv6) so Coder's workspace
#      proxy (which dials the agent's tailnet IPv6 address) can connect.
#
# In the browser app, the Server URL can stay at its default
# http://localhost:5001 — on web it is transparently remapped to /soco
# (same origin → no CORS, no mixed content). See resolveBaseUrl() in
# lib/services/sonos_api.dart.
#
# One-time preparation (persistent, survives workspace updates):
#   python3 -m venv /opt/coder/sonos-tt/soco-venv
#   /opt/coder/sonos-tt/soco-venv/bin/pip install soco-cli
#   HOME=/opt/coder/sonos-tt/soco-home /opt/coder/sonos-tt/soco-venv/bin/soco-discover --subnets 192.168.0.0/24
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=coder-env.sh
source "$SCRIPT_DIR/coder-env.sh"

PERSIST="$SONOS_TT_PERSIST"
PUBLISH_DIR="$PERSIST/publish/web"
LOG_DIR="$PERSIST/logs"
SOCO_VENV="$PERSIST/soco-venv"
SOCO_HOME="$PERSIST/soco-home"
PORT="${PORT:-8099}"
SOCO_PORT="${SOCO_PORT:-5001}"
SOCO_SUBNETS="${SOCO_SUBNETS:-192.168.0.0/24}"
MODE="${1:-}"

mkdir -p "$LOG_DIR" "$SOCO_HOME"

if [ ! -f "$PUBLISH_DIR/index.html" ]; then
    echo "ERROR: no published app at $PUBLISH_DIR — run deploy/coder-build-web.sh first" >&2
    exit 1
fi
if [ ! -x "$SOCO_VENV/bin/soco-http-api-server" ]; then
    echo "[serve] soco-cli missing — installing into persistent venv …"
    python3 -m venv "$SOCO_VENV"
    "$SOCO_VENV/bin/pip" install -q soco-cli
fi

stop_pidfile() {
    local pf="$1" name="$2"
    if [ -f "$pf" ] && kill -0 "$(cat "$pf")" 2>/dev/null; then
        echo "[serve] stopping previous $name (pid $(cat "$pf"))"
        kill "$(cat "$pf")" 2>/dev/null || true
        sleep 0.5
    fi
    rm -f "$pf"
}

stop_pidfile "$LOG_DIR/soco-server.pid" "SoCo-CLI server"
stop_pidfile "$LOG_DIR/web-server.pid" "web server"
# Belt and braces: kill any leftovers (also from older script versions).
pkill -f "soco-mock-server.py" 2>/dev/null || true
pkill -f "soco-http-api-server" 2>/dev/null || true
pkill -f "coder-web-server.py" 2>/dev/null || true
sleep 1

IP="$(hostname -I | awk '{print $1}')"
echo "[serve] app:       $PUBLISH_DIR"
echo "[serve] URLs:      http://$IP:$PORT/   http://localhost:$PORT/"
echo "[serve] SoCo-CLI:  REAL server on :$SOCO_PORT (subnet $SOCO_SUBNETS, HOME=$SOCO_HOME)"
echo "[serve] app API:   same-origin proxy /soco → 127.0.0.1:$SOCO_PORT"

start_soco() {
    HOME="$SOCO_HOME" nohup "$SOCO_VENV/bin/soco-http-api-server" \
        --port "$SOCO_PORT" --use-local-speaker-list --subnets "$SOCO_SUBNETS" \
        >>"$LOG_DIR/soco-server.log" 2>&1 &
    echo $! >"$LOG_DIR/soco-server.pid"
}

start_web() {
    nohup python3 "$SCRIPT_DIR/coder-web-server.py" --port "$PORT" \
        --publish-dir "$PUBLISH_DIR" --soco-url "http://127.0.0.1:$SOCO_PORT" \
        >>"$LOG_DIR/web-server.log" 2>&1 &
    echo $! >"$LOG_DIR/web-server.pid"
}

if [ "$MODE" = "--daemon" ]; then
    start_soco
    start_web
    sleep 2
    echo "[serve] soco pid $(cat "$LOG_DIR/soco-server.pid") → $LOG_DIR/soco-server.log"
    echo "[serve] web  pid $(cat "$LOG_DIR/web-server.pid") → $LOG_DIR/web-server.log"
else
    start_soco
    SOCO_PID=$!
    trap 'kill $SOCO_PID 2>/dev/null || true' EXIT
    exec python3 "$SCRIPT_DIR/coder-web-server.py" --port "$PORT" \
        --publish-dir "$PUBLISH_DIR" --soco-url "http://127.0.0.1:$SOCO_PORT"
fi